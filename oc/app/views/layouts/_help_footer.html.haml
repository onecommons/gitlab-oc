-# OC Change -- how to reach us, under every help page.
.uf-help-footer
  %p
    = _('Questions? Please contact us at')
    = mail_to 'support@unfurl.cloud'
  %p
    = _('Or visit us on')
    = link_to 'https://discord.gg/jtZnZ6hZMn', target: '_blank', rel: 'noopener noreferrer' do
      %img{ alt: 'Discord', src: '/-/oc/assets/images/discord.svg' }
  .uf-help-footer-logo
    = brand_header_logo
