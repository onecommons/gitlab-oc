-# OC Change -- the interface a signup chose, changeable afterwards.
.form-group.gl-mb-4
  = label_tag 'user_oc_interface', _('Interface'), class: 'gl-font-bold'
  = select_tag 'user[oc_interface]',
    options_for_select([[_('Deploy applications'), 'deploy'], [_('Develop applications'), 'develop']],
      current_user.external? ? 'deploy' : 'develop'),
    id: 'user_oc_interface', class: 'form-control gl-form-select'
  %p.gl-text-subtle.gl-mt-2.gl-mb-0
    = _('Deploying gives you a simpler interface.')
