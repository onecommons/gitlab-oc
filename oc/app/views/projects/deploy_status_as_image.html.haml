%head
  :css
    @import url(https://fonts.googleapis.com/css2?family=Open+Sans:wght@500;600;700;800&display=swap);

    :root {
      --unfurl-blue: #00d2d9;
      --border-radius: 8px;
    }

    body {
      margin: 0px;
      background: transparent;
    }

  -# -# random colors for conversion clarity
  -# :css
  -#   :root {
  -#     --border-color: red;
  -#     --logo-color: orange;
  -#     --logo-bg: var(--unfurl-blue);
  -#     --text-color: yellow;
  -#     --text-bg: green;
  -#     --text-leftpad: 15px;
  -#     --count-color: blue;
  -#     --count-bg: purple;
  -#   }

  - case @type
  - when 'default'
    :css
      :root {
        --border-color: transparent;

        --logo-color: #fff;
        --logo-bg: var(--unfurl-blue);

        --text-leftpad: 0;
        --text-color: #fff;
        --text-bg: var(--unfurl-blue);

        --count-color: #4a5053;
        --count-bg: #e0e0e0;
      }

  - when 'white'
    :css
      :root {
        --border-color: var(--unfurl-blue);

        --logo-color: #fff;
        --logo-bg: var(--unfurl-blue);

        --text-leftpad: 15px;
        --text-color: var(--unfurl-blue);
        --text-bg: #fff;

        --count-color: #4a5053;
        --count-bg: #fff;
      }

  - when 'monochrome'
    :css
      :root {
        --border-color: black;

        --logo-color: black;
        --logo-bg: white;

        --text-leftpad: 0;
        --text-color: black;
        --text-bg: white;

        --count-color: black;
        --count-bg: white;
      }

  - when 'mono_inverse'
    :css
      :root {
        --border-color: white;

        --logo-color: white;
        --logo-bg: black;

        --text-leftpad: 0;
        --text-color: white;
        --text-bg: black;

        --count-color: white;
        --count-bg: black;
      }

  - when 'mono_system'
    :css
      :root {
        --border-color: black;

        --logo-color: black;
        --logo-bg: white;

        --text-leftpad: 0;
        --text-color: black;
        --text-bg: white;

        --count-color: black;
        --count-bg: white;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --border-color: white;

          --logo-color: white;
          --logo-bg: black;

          --text-leftpad: 0;
          --text-color: white;
          --text-bg: black;

          --count-color: white;
          --count-bg: black;
        }
      }

  :css
    /* LAYOUT */
    .badge {
      width: min-content;
      height: 64px;

      display: flex;
      align-items: center;
      /* column-gap: 16px; */
      /* padding: 11px; */

      box-sizing: border-box;

      border-radius: calc(var(--border-radius) + 3px);
    }

    .item {
      /* margin: 11px; */
      height: 100%;

      box-sizing: border-box;

      padding: 8px 15px;

      /* vertically center inside each box */
      display: flex;
      flex-direction: column;
      justify-content: space-around;

      font-family: 'Open Sans', 'Noto Sans', sans-serif;
      font-weight: 700;
    }

    /* borders */
    .item {
      border-top: 2px solid var(--border-color);
      border-bottom: 2px solid var(--border-color);
    }

    .item:first-child {
      border-left: 2px solid var(--border-color);
      border-top-left-radius: var(--border-radius);
      border-bottom-left-radius: var(--border-radius);
    }

    .item:last-child {
      border-top-right-radius: var(--border-radius);
      border-bottom-right-radius: var(--border-radius);
      border-right: 2px solid var(--border-color);
    }

    .text {
      width: 130px;
      white-space: nowrap;

      font-size: 18px;

      padding-left: var(--text-leftpad);
    }

    .cloud {
      /* width: 100px; */
      padding-top: 20px;
      padding-bottom: 20px;
      padding-left: 5px;
      height: 100%;
      /* height: fit-content; */
    }

    .count {
      width: min-content;
      padding-left: 15px;

      font-size: 28px;
    }

    /* Default colors */
    .logo {
      background-color: var(--logo-bg);
      fill: var(--logo-color);
    }

    .text {
      background-color: var(--text-bg);
      color: var(--text-color);
    }

    .cloud {
      background-color: var(--text-bg);
      fill: var(--text-color);
    }

    .count {
      background-color: var(--count-bg);
      color: var(--count-color);
      border-left: 2px solid var(--border-color);
    }

