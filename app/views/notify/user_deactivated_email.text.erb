<%= _('Hello %{name},') % { name: @name } %>

<%= _('Your account has been deactivated for %{host}. You will not be able to: ') % { host: @host } %>

  - <%= _('Access Git repositories or the API.') %>
<%# OC Change -%>
  - <%= format(_('Receive any notifications from %{brand}.'), brand: brand_title) %>
  - <%= _('Use slash commands.') %>

<%= _('To reactivate your account, sign in to %{brand} at %{gitlab_url}.') % { brand: brand_title, gitlab_url: root_url } %>

<%= format(_('Please contact %{brand} support if you think this is an error.'), brand: brand_title) %>
<%= render 'layouts/mailer/user_deactivated_additional_text' %>
