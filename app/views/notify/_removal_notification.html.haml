%p
  - if @domain.remove_at
    = s_('Notify|Unless you verify your domain by %{time_start}%{time}%{time_end} it will be removed from your %{brand} project.').html_safe % { brand: brand_title, time_start: '<strong>'.html_safe, time_end: '</strong>'.html_safe, time: @domain.remove_at.strftime('%F %T,') }
  - else
    -# OC Change
    = format(s_('Notify|If you no longer wish to use this domain with %{brand} Pages, please remove it from your %{brand} project and delete any related DNS records.'), brand: brand_title)
